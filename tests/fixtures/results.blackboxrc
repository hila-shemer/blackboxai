! Boot fixture: the Results style + a user rootCommand. The rc line takes
! classic precedence: Results' bsetroot never paints, the desktop is flat
! black, and the rc command is what runs via /bin/sh. Toolbar off so pixel
! checks stay about the desktop.
session.styleFile:   data/styles/Results
session.screen0.enableToolbar: False
rootCommand:         xsetroot -solid gray
